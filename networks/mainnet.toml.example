# Mainnet — TEMPLATE. Copy to <network>.toml and fill the INPUT keys (chain,
# AWS, accounts, Notary Fee); the endpoint is the `RPC_URL` secret of the
# GitHub environment named after the file, never this file. The address keys
# are ALREADY final:
# every canonical contract deploys through the deterministic LibidFactory
# via CREATE3, so its address is a pure function of its frozen name — the
# same on every EVM network, known before the chain has anything on it.
# This file therefore ships FULLY pre-filled and is NEVER rewritten:
# whether a declared contract exists is read from CHAIN STATE
# (`eth_getCode`) at plan/apply time, and `apply` deploys whatever the chain
# lacks, landing at exactly these addresses.
#
# `validate` enforces the declarations: a canonical key whose value is not
# exactly `predict_address(factory, name)` is a validation ERROR. Reprint
# the table any time with `libid-deploy plan --print-addresses` (offline).
#
# The first apply on a VIRGIN network (no factory code on-chain) requires
# `--confirm-fresh-deploy`; after that, applies converge incrementally.

[network]
name = "mainnet"
# The chain id `apply` refuses to run without matching on-chain.
chain_id = 0

[aws]
region = ""
# KMS key id, `alias/...` name, or full ARN of the deployer key. Create it as
# ECC_SECG_P256K1 / SIGN_VERIFY and fund its derived address before applying.
kms_deployer = ""

# Addresses of KEYS (not contracts), derived from their own KMS keys.
#
# `notary` is the notary SIGNER — the identity whose attestations the whole
# stack accepts. The Notary Service CONTRACT (`contracts.notary_service`
# below) holds the trusted key set: apply initializes it with this key and
# adds it when it is missing. Dropping an outgoing key is a separate
# governance call, so a rotation can overlap.
#
# `deployer` is the address `kms_deployer` derives to: the genesis admin baked
# into the factory's init code, so the whole `[contracts]` table below follows
# from it. The placeholder is anvil account #0, and the table below is ITS
# table; set the real deployer, then regenerate the table with
# `plan --network <this file> --print-addresses`. Mainnet's deployer is its
# own key (the libid-mainnet AWS account), so mainnet's table differs from
# testnet's.
#
# `owner` is the OPERATIONAL OWNER the factory should end up with. The
# deployer owns it from genesis and is the apply signer, so leaving it empty
# (= default to the deployer) is exact. Set it only to hand the factory to a
# different key: apply then INITIATES the Ownable2Step transfer and that key
# must acceptOwnership itself.
[accounts]
deployer = "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
notary = ""
owner = ""

[notary_service]
# What one attestation verification costs, in wei, as a decimal string
# (TOML integers do not reach uint256). Charged per attestation: a
# TLSNotary profile carries two, Google's carries none. Editing it makes
# apply send `setFee`.
fee_wei = "0"

# DECLARED canonical addresses — the deployer's table, identical on every
# EVM network that deployer deploys to; validated to equal
# predict_address(factory, name). Do not hand-edit: regenerate with
# `plan --print-addresses` after setting `accounts.deployer`; a different
# value is a validation error naming the expected one.
#
# `factory` is the deterministic LibidFactory proxy (CREATE2, frozen init
# code). `notary_service` is the Notary Service PROXY — the one place a
# notary attestation is authenticated; it deploys FIRST and is wired into
# every consumer at initialize. Not the signer; that is `accounts.notary`.
#
# `handle_escrow` is initialized with `identity_registry` and resolves every
# handle through it for life: no setter moves it.
#
# `google_jwt_roots` starts EMPTY on-chain — point a keeper at it, or every
# Google binding reverts UntrustedModulus().
[contracts]
factory = "0x13089b18e7fdcdedde55f6b85451561a8b725825"
notary_service = "0x278e8ba43e16e1d757fe77590edb759d85860483"
ceremony_proof_verifier = "0x7eb419023544487e5b4a61d6db043a8e29c4df4e"
identity_registry = "0x31874a585aab1f98121f14f4b2af68a93eaaa9a5"
handle_escrow = "0x520996cdbccfffd952a5134dab146b6fac7b103c"
google_jwt_roots = "0x6d5bc82c9a8a6a05a9319c9e9d5fc43ff80552ac"
x_platform_verifier = "0xcced9e8428f4043d00d4d5dfc293d864bb2bc204"
github_platform_verifier = "0x4dfff81322459ca460e3ddede2b8dcb33bf10745"
google_platform_verifier = "0x5de9d5f806d872315bfdfde5b5eb8f97ebcb743d"

# The ceremony circuit verifiers are NOT declared here. `libid-deploy`
# carries them: `libid-contracts` embeds each circuit's bb-generated
# UltraHonk verifier from the libid-circuits release it pins, and apply
# deploys it through the factory under a CREATE3 name carrying that
# release. Each Platform Verifier implementation compiles in the code
# hash of its circuit's verifier, so a new circuits release is a new name,
# a new address, an `--upgrade` of the Platform Verifiers and a
# `setTrustRoots`, with the proxies and their registrations untouched.
