# Mainnet — TEMPLATE. Copy to mainnet.toml, fill the INPUT keys, and leave
# every OUTPUT key empty: the first `apply --confirm-fresh-deploy` run fills
# them and opens a PR recording what it deployed.
#
# This template describes the CURRENT (libid-contracts 0.2.0, Notary-era)
# schema: the shared Notary contract deploys first and every other contract
# is wired to its proxy at initialize. networks/eden-testnet.toml is a
# fully-populated example of the input-vs-output key convention, but note
# that it records the LEGACY pre-Notary deployment (see its header).

[network]
name = "mainnet"
# The chain id `apply` refuses to run without matching on-chain.
chain_id = 0
rpc_url = ""

[aws]
region = ""
# KMS key id, `alias/...` name, or full ARN of the deployer key. Create it as
# ECC_SECG_P256K1 / SIGN_VERIFY and fund its derived address before applying.
kms_deployer = ""

# Addresses of KEYS (not contracts), derived from their own KMS keys.
#
# `notary` is the notary SIGNER — the EOA/KMS identity whose attestations
# the whole stack accepts. The Notary CONTRACT (`contracts.notary` below)
# stores this address: apply initializes it with this value, and later
# editing this key makes apply rotate the on-chain signer via `setNotary`
# (one transaction; every consumer follows the contract).
[accounts]
notary = ""
backend = ""

# OUTPUT — leave empty. Filled by `libid-deploy apply`.
#
# `notary` is the Notary PROXY address — the one contract everything else
# verifies notary attestations through. It deploys FIRST and is wired into
# every consumer at initialize. Not the signer; that is `accounts.notary`.
[contracts]
notary = ""
bank = ""
registry = ""
wallet_factory = ""
x_zk_verifier = ""
google_oidc_verifier = ""

# OUTPUT — the identity-names stack. Uncomment to request it; a key present
# but empty is a deploy request, an absent key is "not wanted".
# [identity]
# identity_names = ""
# github_identity_verifier = ""
# x_identity_verifier = ""
# google_identity_verifier = ""   # also deploys identity_jwks_roots

# INPUT: OAuth client ids (public, not secrets) and bot handles. The Google
# client id is REQUIRED to deploy the OIDC verifier — it is enforced on-chain
# as the JWT audience. An empty x_client_id skips the X ZK verifier deploy.
[platforms]
x_client_id = ""
google_client_id = ""
github_bot_handle = ""
x_bot_handle = ""

# INPUT: tokens to register on the Bank.
# [[tokens]]
# symbol = "$TIA"
# address = "0x0000000000000000000000000000000000000000" # native

# INPUT: comment templates pushed to the Bank, keyed by platform domain.
# Placeholders: {recipient}, {amount}, {token}.
[templates]
# "api.github.com" = ["@bot honor @{recipient} with {amount} of {token}"]
# "api.x.com" = ["@bot honor @{recipient} with {amount} of {token}"]
